NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: captcha after 3 failed sign-ins (Cloudflare Turnstile, free). Leave blank to rely on lockout and backoff only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: secret used to hash emails in rate-limit keys and the auth log. Defaults to the service role key.
RATE_LIMIT_SALT=

# Optional: secret that signs receipt print links. Defaults to the service role key.
PRINT_SECRET=
