NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: captcha after 3 failed sign-ins (Cloudflare Turnstile, free). Leave blank to rely on lockout and backoff only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: secret used to hash emails in rate-limit keys and the auth log. Defaults to the service role key.
RATE_LIMIT_SALT=

# Optional: secret that signs receipt print links. Defaults to the service role key.
PRINT_SECRET=

# Phone alerts for owners (web push). Generate a pair once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@biziirise.com

# A long random string. The hourly job that sends end-of-day summaries must present it.
CRON_SECRET=

# Set this if the site answers on both uzaa.co.ke and www.uzaa.co.ke, so one sign-in works on both.
# Leading dot, no protocol. Leave empty for a single host.
COOKIE_DOMAIN=.uzaa.co.ke
