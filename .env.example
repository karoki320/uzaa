NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: captcha after 3 failed sign-ins (Cloudflare Turnstile, free). Leave blank to rely on lockout and backoff only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: secret used to hash emails in rate-limit keys and the auth log. Defaults to the service role key.
RATE_LIMIT_SALT=

# Optional: secret that signs receipt print links. Defaults to the service role key.
PRINT_SECRET=

# Phone alerts for owners (web push). Generate a pair once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@biziirise.com

# A long random string. The hourly job that sends end-of-day summaries must present it.
CRON_SECRET=
VAPID_PUBLIC_KEY=BGLMoXnT6YYBO5H4alU3ahDUsFy7g4tMoND_D5x39y37htyhjstEeI6FXBNGtdhdLd4XT6FioxIu7wyOpEJjL68
VAPID_PRIVATE_KEY=UQHQiA3t14hr9ljKQZderXedDDK5uS2puL6ZuV28mUw
VAPID_SUBJECT=mailto:hello@biziirise.com
CRON_SECRET=(a long random string)
# Paystack (subscription billing). Test keys while testing: sk_test_... Swap for sk_live_... to go live.
# Dashboard: Settings > API Keys & Webhooks. Set the webhook URL there to https://uzaa.co.ke/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Days after the due date before an unpaid business is locked (default 7)
BILLING_GRACE_DAYS=7
